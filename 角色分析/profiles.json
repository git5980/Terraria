{
  "_说明": [
    "角色配置模板：player_ops.js 里 CONFIG.profile 写模板名即可套用，可作用于任意角色（含以后新建的）。",
    "persistent = 写一次就留住的字段；continuous = 每帧被 ResetEffects 重算、需 Hook 持续压住的字段；actions = 一次性动作。",
    "脚本里的 CONFIG.persistent / continuous / actions 优先级高于模板，可做临时覆盖。",
    "JSON 不支持注释，所以说明都写成 _ 开头的键；字段名与 角色状态快照.json 一致。"
  ],
  "profiles": {
    "无": {},

    "快速起步": {
      "persistent": { "statLifeMax": 200, "statLifeMax2": 200, "statLife": 200, "statManaMax": 100, "statManaMax2": 100, "statMana": 100 }
    },

    "满配角色": {
      "persistent": {
        "statLifeMax": 500, "statLifeMax2": 500, "statLife": 500,
        "statManaMax": 200, "statManaMax2": 200, "statMana": 200,
        "breath": 400
      },
      "continuous": {
        "statDefense": 100,
        "meleeDamage": 3, "rangedDamage": 3, "magicDamage": 3, "minionDamage": 3,
        "meleeCrit": 100, "rangedCrit": 100, "magicCrit": 100,
        "moveSpeed": 1.8, "maxRunSpeed": 9, "accRunSpeed": 6, "jumpSpeedBoost": 4,
        "wingTime": 200, "wingTimeMax": 200,
        "luck": 1, "endurance": 0.5
      }
    },

    "上帝模式": {
      "continuous": {
        "statDefense": 200, "endurance": 0.5,
        "immuneTime": 3600, "onHitDodge": true, "shadowDodge": true,
        "lavaImmune": true, "shimmerImmune": true,
        "breath": 400, "lavaMax": 3600
      },
      "actions": { "heal": -1 }
    },

    "飞毛腿": {
      "continuous": { "moveSpeed": 1.6, "maxRunSpeed": 12, "accRunSpeed": 9, "jumpSpeedBoost": 5, "autoJump": true }
    },

    "工匠快采": {
      "continuous": { "pickSpeed": 5, "tileSpeed": 5, "wallSpeed": 5, "moveSpeed": 1.4 }
    },

    "幸运拉满": {
      "continuous": { "luck": 1 }
    },

    "经典难度": {
      "persistent": { "difficulty": 0 }
    },

    "旅途难度": {
      "persistent": { "difficulty": 3 }
    },

    "回满血": {
      "actions": { "heal": -1 }
    },

    "清减益": {
      "actions": { "clearDebuffs": true }
    },

    "强力增益包": {
      "actions": {
        "buffs": [
          { "type": 1, "time": 36000 },
          { "type": 2, "time": 36000 },
          { "type": 3, "time": 36000 },
          { "type": 5, "time": 36000 },
          { "type": 6, "time": 36000 },
          { "type": 7, "time": 36000 },
          { "type": 9, "time": 36000 },
          { "type": 12, "time": 36000 },
          { "type": 13, "time": 36000 },
          { "type": 16, "time": 36000 },
          { "type": 17, "time": 36000 }
        ]
      }
    }
  }
}
